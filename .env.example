# Application
APP_NAME=AdGenius AI
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8080
SPRING_PROFILES_ACTIVE=dev

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=adgenius
MYSQL_USER=adgenius
MYSQL_PASSWORD=change-me-strong-password
MYSQL_ROOT_PASSWORD=change-me-root-password

# JWT — generate a long random secret (min 32 chars)
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret-min-32-chars
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret-min-32-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600

# Cookies
COOKIE_SECURE=false
COOKIE_DOMAIN=
COOKIE_SAMESITE=Lax

# CORS (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Bootstrap admin (created on first boot if missing)
ADMIN_BOOTSTRAP_EMAIL=admin@adgenius.local
ADMIN_BOOTSTRAP_PASSWORD=ChangeMeAdmin!234
ADMIN_BOOTSTRAP_NAME=AdGenius Admin

# Mail — leave empty to log tokens in demo/dev
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@adgenius.local

# OpenAI — leave empty to enable labeled DEMO MODE
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_CHAT_MODEL=gpt-4o-mini

# Replicate — leave empty to enable labeled DEMO MODE
REPLICATE_API_TOKEN=
REPLICATE_VIDEO_MODEL=stability-ai/stable-video-diffusion

# AWS S3 — leave empty to use local disk storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=

# Razorpay — leave empty to enable labeled DEMO payment mode
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Credits
FREE_PLAN_INITIAL_CREDITS=50
IMAGE_GENERATION_CREDIT_COST=2
VIDEO_GENERATION_CREDIT_COST=10
CONTENT_GENERATION_CREDIT_COST=1

# Storage
LOCAL_STORAGE_DIR=./data/media
MAX_UPLOAD_BYTES=10485760

# Rate limiting
AUTH_RATE_LIMIT_PER_MINUTE=10
